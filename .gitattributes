# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Source code files
*.java text diff=java eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.gradle text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts
*.sh text eol=lf
gradlew text eol=lf

# Binary files
*.jar binary
*.war binary
